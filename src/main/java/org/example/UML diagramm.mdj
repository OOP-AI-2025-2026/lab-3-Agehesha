@startuml
skinparam classAttributeIconSize 0

class Box {
  - length: double
  - width: double
  - height: double
  --
  + Box(length: double, width: double, height: double)
  - setLength(length: double): void
  - setWidth(width: double): void
  - setHeight(height: double): void
  - validatePositive(name: String, value: double): void
  + surfaceArea(): double
  + lateralSurfaceArea(): double
  + volume(): double
}

class Item {
  - id: String
  - name: String
  - price: BigDecimal
  --
  + Item(id: String, name: String, price: BigDecimal)
  + getId(): String
  + getName(): String
  + getPrice(): BigDecimal
}

class Cart {
  - lines: Map<Item, Integer>
  --
  + add(item: Item, quantity: int): void
  + setQuantity(item: Item, quantity: int): void
  + remove(item: Item): void
  + clear(): void
  + isEmpty(): boolean
  + uniqueItems(): int
  + total(): BigDecimal
  + snapshotView(): List<String>
  - validate(item: Item, quantity: int): void
}

enum Status {
  NEW
  PAID
  SHIPPED
  CANCELED
}

class Order {
  - orderId: String
  - customer: String
  - createdAt: LocalDateTime
  - lines: List<OrderLine>
  - status: Status
  --
  + Order(orderId: String, customer: String, lines: List<OrderLine>)
  + {static} fromCart(orderId: String, customer: String, cart: Cart): Order
  + getOrderId(): String
  + getCustomer(): String
  + getCreatedAt(): LocalDateTime
  + getStatus(): Status
  + viewLines(): List<String>
  + total(): BigDecimal
  + pay(): void
  + cancel(): void
  - ensure(expected: Status, action: String): void
}

class OrderLine <<private>> {
  - text: String
  --
  - readonlyText(): String
}

Cart "1" o-- "0..*" Item : contains
Order "1" *-- "1..*" OrderLine : composes
Order ..> Cart : «uses fromCart»
Order ..> Status
IntStack : +IntStack()
IntStack : +push(value: int): void
IntStack : +pop(): int
IntStack : +peek(): int
IntStack : +size(): int
IntStack : +isEmpty(): boolean
IntStack : +clear(): void
IntStack : -data: int[]
IntStack : -size: int
IntStack : -ensureCapacity(min: int): void
@enduml
